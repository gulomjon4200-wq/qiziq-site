# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Postgres (n8n's own database) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# --- n8n instance ---
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_PORT=5678
# If n8n is exposed publicly over HTTPS (required for the YouTube OAuth2 redirect
# and recommended in general), set these to your real domain, e.g.:
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.example.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=
TZ=Asia/Tashkent

# --- Instagram -> YouTube pipeline ---
# JSON array of Instagram Business/Creator accounts you have permission to
# republish. Each account needs a long-lived Instagram Graph API access token
# for ITS OWN ig_user_id (see README.md for how to obtain one).
# Example:
# ACCOUNTS_JSON=[{"name":"account1","ig_user_id":"17841400000000000","access_token":"EAAG..."}]
ACCOUNTS_JSON=[]

# How many of the most recent posts to check per account on each run.
IG_FETCH_LIMIT=5

# Default visibility for uploaded YouTube videos: public | unlisted | private
YT_PRIVACY_STATUS=unlisted
