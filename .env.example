# API-Football (api-sports.io) kaliti. Yo'riqnoma README.md ichida.
API_FOOTBALL_KEY=BU_YERGA_APIKEYNI_YOZING

# Server porti (lokal)
PORT=3000

# Kunlar uchun vaqt zonasi (fixture sanalarini to'g'ri bo'lish uchun)
TIMEZONE=Asia/Tashkent

# API-Football mavsum yili (masalan 2025/2026 mavsumi uchun 2025).
# Bo'sh qoldirsangiz, server joriy sanaga qarab avtomatik hisoblaydi.
SEASON=

# Har bir tashqi API so'rovi orasidagi minimal kutish vaqti (ms).
# Bepul tarifda daqiqalik limitga urilib qolmaslik uchun kerak.
API_REQUEST_DELAY_MS=350

# Har kuni soat nechada (yuqoridagi TIMEZONE bo'yicha) ma'lumotlar avtomatik
# yangilansin. Server shu vaqtda "bugun" va "ertaga" o'yinlarini keshni
# chetlab o'tib qayta yuklaydi - buning uchun server doim ishlab turishi kerak.
DAILY_REFRESH_HOUR=6
